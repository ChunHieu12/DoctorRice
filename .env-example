# ============================================
# Environment Variables Example
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control
# ============================================

# ============================================
# FRONTEND (Mobile App)
# ============================================

# API Base URL (overrides app.json if set)
# Development: Use local backend
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Production: Use deployed backend (uncomment to override app.json)
# EXPO_PUBLIC_API_URL=https://doctorrice.onrender.com/api

# ============================================
# BACKEND (Node.js API)
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/doctorrice?retryWrites=true&w=majority

# JWT Secrets (Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this-in-production
JWT_EXPIRES=1d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-min-32-chars-change-this
REFRESH_TOKEN_EXPIRES=7d

# Twilio SMS OTP Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Firebase Admin (for phone OTP verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKey\n-----END PRIVATE KEY-----\n"

# Facebook OAuth (for Facebook Login)
FACEBOOK_APP_ID=1071463597343527
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# Logging & Security
LOG_LEVEL=info
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_DIR=./uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:8081,https://yourdomain.com

# Render Keep-Alive (Optional - for Render.com deployment)
CRON_SECRET=your-cron-secret-for-keep-alive-endpoint
RENDER_INTERNAL_URL=https://doctorrice.onrender.com



# ============================================
# SENTRY (Optional - for error tracking)
# ============================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# NOTES
# ============================================

# 1. Never commit real .env file to git
# 2. Keep secrets secure and rotate regularly
# 3. Use different secrets for dev/staging/production
# 4. For Twilio: Get credentials from Twilio Console (https://console.twilio.com)
#    - Account SID: Found on console dashboard
#    - Auth Token: Found on console dashboard (click to reveal)
#    - Verify Service SID: Create Verify Service in Twilio Console
# 5. For Facebook Login: Get App ID and App Secret from Facebook Developers
#    - Go to https://developers.facebook.com/apps/
#    - App ID is public (can be in app.json)
#    - App Secret MUST ONLY be in backend .env (NEVER in mobile app!)
# 6. For production: Use strong, randomly generated secrets (min 32 chars)
