# ================================
# APP CONFIGURATION
# ================================
# API Base URL (Backend endpoint)
API_URL=http://localhost:3000

# App Environment (development, staging, production)
APP_ENV=development

# ================================
# AUTHENTICATION & SOCIAL LOGIN
# ================================
# Google OAuth Client ID (Android)
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android.apps.googleusercontent.com

# Google OAuth Client ID (iOS)
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios.apps.googleusercontent.com

# Google OAuth Client ID (Web)
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web.apps.googleusercontent.com

# Facebook App ID
FACEBOOK_APP_ID=your-facebook-app-id

# Facebook App Display Name
FACEBOOK_DISPLAY_NAME=DoctorRice

# ================================
# MONITORING & ERROR TRACKING
# ================================
# Sentry DSN (optional - for error tracking)
SENTRY_DSN=

# ================================
# FEATURE FLAGS
# ================================
# Enable/Disable features
ENABLE_SOCIAL_LOGIN=true
ENABLE_PHONE_LOGIN=true
ENABLE_WATERMARK=true

# ================================
# BACKEND VARIABLES (for backend server)
# ================================
# Server Port
PORT=3000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/doctorrice

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT Expiration Time
JWT_EXPIRES=7d

# Refresh Token Expiration
REFRESH_TOKEN_EXPIRES=30d

# Google OAuth Secret (Backend verification)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook App Secret (Backend verification)
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Cron Secret (for Render wake-up ping protection)
CRON_SECRET=your-cron-secret-key-change-this

# Render Internal URL (for self-ping)
RENDER_INTERNAL_URL=https://your-app.onrender.com

# ================================
# FILE STORAGE
# ================================
# Upload directory path
UPLOAD_DIR=./uploads

# Max file size (in bytes - 10MB default)
MAX_FILE_SIZE=10485760

# ================================
# RATE LIMITING
# ================================
# Rate limit window (in minutes)
RATE_LIMIT_WINDOW=15

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# CORS CONFIGURATION
# ================================
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,exp://192.168.1.100:8081

# ================================
# LOGGING
# ================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

