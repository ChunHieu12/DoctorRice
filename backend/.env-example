FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Render Keep-Alive (to prevent free tier sleep)
# Set this to your Render app URL (e.g., https://doctorrice.onrender.com)
RENDER_INTERNAL_URL=https://doctorrice.onrender.com
RENDER_EXTERNAL_URL=https://doctorrice.onrender.com

# Cloudinary (Image Storage & Watermarking)
# Used for:
# - Upload original photos
# - Add GPS watermark to images
# - Generate thumbnails for map markers
# - CDN delivery
CLOUDINARY_CLOUD_NAME=doivrdij4
CLOUDINARY_API_KEY=616512921233148
CLOUDINARY_API_SECRET=8AjYrlt8GOt9TvbBv7MIFB4gdxk

# AI Service (Python TensorFlow Lite Microservice)
