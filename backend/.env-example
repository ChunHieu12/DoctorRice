# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/doctorrice

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-change-in-production
REFRESH_TOKEN_EXPIRES=30d

# Firebase Admin SDK (for token verification)
FIREBASE_PROJECT_ID=doctorrice-4e19f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@doctorrice-4e19f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AWS SNS (for SMS)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_SMS_SENDER_ID=DoctorRice

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Test Phone Numbers (comma-separated, optional)
# Leave empty to disable test mode
TEST_PHONE_NUMBERS=

# Render Keep-Alive (optional)
CRON_SECRET=your-cron-secret-for-keep-alive

